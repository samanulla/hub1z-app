# ---------- Core ----------
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=hub1z
APP_BASE_URL=http://localhost:5000
# ---------- Multi-tenancy ----------
# 'shared' = one deployment serves many tenants (resolved from Host header)
# 'dedicated' = one deployment per tenant (TENANT_ID must be set)
DEPLOY_MODE=shared
# TENANT_ID=1
PLATFORM_BASE_DOMAIN=hub1z.com
# Days a self-serve tenant sign-up (/auth/register/tenant) gets before login is blocked pending Approval.
TENANT_TRIAL_DAYS=14

# ---------- Database (PostgreSQL) ----------
# Local Postgres (docker-compose publishes it on 5433 by default):
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://coworkhub:coworkhub@localhost:5433/coworkhub
# AWS RDS example:
# DATABASE_URL=postgresql+psycopg2://coworkhub:${DB_PASSWORD}@coworkhub-prod.xxxx.us-east-1.rds.amazonaws.com:5432/coworkhub?sslmode=require

# ---------- Storage ----------
# Backends: local | s3 | azure_blob
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/uploads

# AWS S3
AWS_REGION=us-east-1
# Dedicated roots for platform-owned and operator-owned documents.
# Replace these placeholders with real private S3 bucket names before enabling S3.
AWS_S3_PLATFORM_BUCKET=hub1z-platform-documents
AWS_S3_OPERATOR_BUCKET=hub1z-operator-documents
# Legacy fallback bucket; used only if the scoped bucket values are blank.
AWS_S3_BUCKET=
AWS_S3_PREFIX=documents/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Signed URL TTL (seconds)
AWS_S3_URL_TTL=3600

# Azure Blob (used when STORAGE_BACKEND=azure_blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# ---------- Email ----------
# Local dev with MailHog / MailPit on port 1025:
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@hub1z.com

# Production (AWS SES SMTP): create an SES SMTP credential in the AWS console,
# verify your sending domain, then set:
#   MAIL_SERVER=email-smtp.ap-south-1.amazonaws.com   # your SES region
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USERNAME=AKIA...   (SES SMTP username)
#   MAIL_PASSWORD=...       (SES SMTP password)
#   MAIL_DEFAULT_SENDER=no-reply@yourdomain.com  (must be verified in SES)
# During tests, set MAIL_SUPPRESS_SEND=true to skip actual delivery.
MAIL_SUPPRESS_SEND=false

# ---------- Booking rules ----------
BOOKING_MIN_ADVANCE_MINUTES=15
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_CANCEL_WINDOW_MINUTES=60
DEFAULT_ROOM_SLOT_MINUTES=30

# ---------- Sample tenant admin bootstrap (used by `flask seed-demo`) ----------
# This is the seeded TENANT admin (Adyar Space), not the platform super admin.
# Use a tenant domain here — never hub1z.com, which is reserved for the platform.
BOOTSTRAP_ADMIN_EMAIL=admin@adyarspace.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
TIMEZONE=Asia/Kolkata
